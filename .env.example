# API (apps/api)
PORT=8787
JWT_SECRET=cambiar-en-produccion
# SQLite local (default). Esquema SQL externo: docs/sql/
DATABASE_URL=file:./data/accesopro.db
# Futuro (la API aún no abre estos drivers):
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/accesopro
# DATABASE_URL=mysql://root@127.0.0.1:3306/accesopro

# Web (apps/web)
# Vacío = el browser habla con :3000 y Next reescribe a la API (mejor para LAN/ZeroTier)
NEXT_PUBLIC_API_URL=
# Orígenes del dashboard (coma-separados). Si falta, se aceptan LAN/localhost.
WEB_ORIGIN=http://localhost:3000
HOST=0.0.0.0

# Agent Dahua (apps/agent)
ACCESOPRO_API_URL=http://localhost:8787
SITE_AGENT_TOKEN=accesopro-demo-agent
# URL del agent para live JPEG (API → agent → Dahua)
SITE_AGENT_URL=http://127.0.0.1:8790

# Motor LAN AccesoSeguro (ALPR / evidencias)
SITE_ENGINE_URL=http://127.0.0.1:5051
ACCESOPRO_BRIDGE_KEY=accesopro-bridge
SITE_ENGINE_USER=admin
SITE_ENGINE_PASSWORD=admin

# Plano del predio: osm (default) o google
NEXT_PUBLIC_MAP_PROVIDER=osm
# Opcional. Maps JavaScript API; restringir por HTTP referrer en Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# roadmap | satellite | hybrid
NEXT_PUBLIC_GOOGLE_MAPS_TYPE=hybrid

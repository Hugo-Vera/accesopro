# Copiar a .env antes de: scripts\start-server.ps1  o  docker compose up
JWT_SECRET=cambiar-en-produccion-docker
WEB_ORIGIN=http://localhost:3000

# Vacío = same-origin (recomendado). No apuntar al :8787 desde el browser.
NEXT_PUBLIC_API_URL=

# API → agent Dahua (nombre Docker en compose)
SITE_AGENT_URL=http://agent:8790
SITE_AGENT_TOKEN=accesopro-demo-agent

# Plano: osm | google (se hornea en el build de web)
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_TYPE=hybrid

# Self-update desde Configuración → «Actualizar servidor» (solo Ubuntu + Docker)
ACCESOPRO_ALLOW_SELF_UPDATE=1
ACCESOPRO_HOST_DIR=/opt/accesopro
# Usuario Linux dueño del clone (tiene que existir en el Ubuntu, no el de Windows)
ACCESOPRO_OWNER=hugo
ACCESOPRO_OWNER_UID=1000
ACCESOPRO_OWNER_GID=1000
ACCESOPRO_REPO=Hugo-Vera/accesopro
ACCESOPRO_BRANCH=master

# Predio nuevo (garita): saltea Las Acacias y espera el bootstrap del concentrador.
# En el concentrador NO setear ACCESOPRO_HUB_TOKEN (si no, no se crea admin@accesopro.local).
# ACCESOPRO_HUB_TOKEN=
# ACCESOPRO_TENANT_NAME=

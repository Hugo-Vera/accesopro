# Copiar a .env antes de: scripts\start-server.ps1  o  docker compose up
JWT_SECRET=cambiar-en-produccion-docker
WEB_ORIGIN=http://localhost:3000

# Vacío = same-origin (recomendado). No apuntar al :8787 desde el browser.
NEXT_PUBLIC_API_URL=

# API → servicios LAN (nombres Docker en compose)
SITE_ENGINE_URL=http://site:5051
SITE_ENGINE_USER=admin
SITE_ENGINE_PASSWORD=admin
ACCESOPRO_BRIDGE_KEY=accesopro-bridge
ENGINE_BRIDGE_POLL_MS=5000

SITE_AGENT_URL=http://agent:8790
SITE_AGENT_TOKEN=accesopro-demo-agent
